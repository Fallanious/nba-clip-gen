# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001

# AWS / S3 Playback
AWS_REGION=us-east-2
S3_BUCKET=
S3_CLIPS_PREFIX=clips/
S3_GAMES_PREFIX=games/

# Playback Configuration
PLAYBACK_URL_TTL=300
PLAYBACK_FALLBACK_TTL=900
PLAYBACK_ALLOW_FALLBACK=true
PLAYBACK_VERIFY_OBJECT=true

# Security
CURSOR_SECRET=change-this-to-a-random-secret-in-production

# App Environment (dev, staging, production)
APP_ENV=dev
