# Optional process environment for yt-dlp downloads.
# download_video.py does not load this file; export these in the shell (or the
# process supervisor) if you want them to apply to the CLI.

# Maximum video resolution in pixels (default: 720)
# Valid range: 144-4320 (144p to 8K)
# Must be at least 144 to ensure proper quality filtering
YTDLP_MAX_RES=720

# Download timeout in seconds (default: 1800, 30 minutes)
# Clamped to 10–7200
YTDLP_TIMEOUT=1800

# Socket timeout for network operations in seconds (default: 60)
# Clamped to 5–300
YTDLP_SOCKET_TIMEOUT=60

# Maximum file size in bytes (default: 5GiB)
# Clamped to 1MiB–20GiB
YTDLP_MAX_FILESIZE=5368709120
