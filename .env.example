# Video Download Security Configuration
# Configure yt-dlp security settings

# Maximum video resolution in pixels (default: 720)
# Valid range: 144-4320 (144p to 8K)
# Must be at least 144 to ensure proper quality filtering
YTDLP_MAX_RES=720

# Download timeout in seconds (default: 1800, 30 minutes)
YTDLP_TIMEOUT=1800

# Socket timeout for network operations in seconds (default: 300, 5 minutes)
YTDLP_SOCKET_TIMEOUT=300

# Maximum file size in bytes (default: 5GB)
# Set to 0 to disable limit
YTDLP_MAX_FILESIZE=5368709120

